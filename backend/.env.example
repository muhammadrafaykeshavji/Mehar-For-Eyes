DATABASE_URL=postgres://mehar:mehar_dev@localhost:5432/mehar?sslmode=disable
API_ADDR=:8080
UPLOAD_DIR=./data/uploads
ALLOW_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=mehar_dev

ADMIN_EMAIL=admin@example.com
# Generate with: go run ./cmd/hashpw
# IMPORTANT: keep the single quotes, the hash contains $ characters.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$REPLACE$ME'
COOKIE_SECURE=true
# Set true only when running behind Caddy/Cloudflare so rate limiting sees the real client IP.
TRUST_PROXY=false
