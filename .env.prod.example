# Domain & TLS (Caddy automatic HTTPS)
DOMAIN=meharforeyes.com
ACME_EMAIL=admin@meharforeyes.com

# Public storefront config
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# Postgres credentials (internal Docker network only)
POSTGRES_USER=mehar
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
POSTGRES_DB=mehar

# Single-admin login credentials
# Generate hash with:
#   cd backend && go run ./cmd/hashpw 'YourStrongPassword'
# In Docker Compose env files, escape each '$' as '$$' so Docker does not interpolate it.
ADMIN_EMAIL=admin@meharforeyes.com
ADMIN_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=2$$REPLACE_SALT$$REPLACE_HASH

