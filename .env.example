# Pakistan WhatsApp number for wa.me links.
# Digits only: country code 92 + 10-digit mobile number.
# Example: 923001234567
# Do not include + or a leading 0.
NEXT_PUBLIC_WHATSAPP_NUMBER=92XXXXXXXXXX

# Optional landline/mobile for the Call button on the home page.
# Same format as above. Falls back to NEXT_PUBLIC_WHATSAPP_NUMBER when omitted.
# NEXT_PUBLIC_PHONE_NUMBER=92XXXXXXXXXX

# Public site origin used in WhatsApp product links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go backend origin used by Next.js server fetches and rewrites (no trailing slash).
API_URL=http://localhost:8080
